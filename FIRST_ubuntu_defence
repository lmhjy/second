#!/bin/bash

echo "=== 监控防守脚本已启动 ==="
echo "正在记录当前安全的系统人员名单..."

# 备份当前干净的“户口本”文件
cp /etc/passwd /tmp/passwd.bak
cp /etc/group /tmp/group.bak
cp /etc/shadow /tmp/shadow.bak

echo "记录完毕，开始 24 小时巡逻..."
echo "---------------------------------"

# 开启无限循环，死死盯住系统
while true
do
    # 1. 检查是否有 UID 为 0 的“假冒伪劣”管理员（排除正常的 root 账号）
    HACKERS=$(awk -F: '($3 == 0) && ($1 != "root") {print $1}' /etc/passwd)
    
    for hacker in $HACKERS
    do
        if [ -n "$hacker" ]; then
            echo "[警报] 发现有人偷偷提权 (UID=0)！账号名: $hacker"
            
            # 强制断开这个坏蛋的网络连接
            pkill -u $hacker 2>/dev/null
            
            # 强制删除这个账号以及他的老巢（主目录）
            userdel -r -f $hacker 2>/dev/null
            
            echo "[处理] 已成功踢出并消灭越权账号: $hacker"
            
            # 迅速把系统的户口本恢复成我们最初备份的干净状态
            cat /tmp/passwd.bak > /etc/passwd
            cat /tmp/group.bak > /etc/group
            cat /tmp/shadow.bak > /etc/shadow
            echo "[恢复] 系统名单已恢复正常。"
            echo "---------------------------------"
        fi
    done

    # 2. 检查是否有不在原始名单里的“黑户”偷偷建号
    NEW_USERS=$(diff /tmp/passwd.bak /etc/passwd | grep "^> " | awk -F':' '{print $1}' | awk '{print $2}')
    
    for user in $NEW_USERS
    do
        if [ -n "$user" ]; then
            echo "[警报] 发现陌生人偷偷建号！账号名: $user"
            
            pkill -u $user 2>/dev/null
            userdel -r -f $user 2>/dev/null
            
            echo "[处理] 已成功踢出并消灭非法账号: $user"
            
            cat /tmp/passwd.bak > /etc/passwd
            cat /tmp/group.bak > /etc/group
            cat /tmp/shadow.bak > /etc/shadow
            echo "[恢复] 系统名单已恢复正常。"
            echo "---------------------------------"
        fi
    done

    # 巡视完毕，休息 2 秒钟，然后开始下一轮巡视
    sleep 2
done
